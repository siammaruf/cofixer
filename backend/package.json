{
    "name": "cofixer-backend",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "prepare": "husky",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "concurrently \"npm:start:dev:server\" \"npm:lint:watch\" --names \"SERVER,LINT\" --prefix-colors \"cyan,yellow\"",
        "start:dev:server": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
        "lint:watch": "nodemon --watch src --watch test --ext ts --exec \"npm run lint:check\"",
        "type-check": "tsc --noEmit",
        "type-check:watch": "tsc --noEmit --watch",
        "test": "jest",
        "test:ci": "jest --ci --coverage --maxWorkers=2",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli -d src/config/db.config.ts",
        "migration:create": "cross-env ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli migration:create ./src/database/migrations/%npm_config_name%",
        "migration:generate": "cross-env npm run typeorm -- migration:generate ./src/database/migrations/%npm_config_name%",
        "migration:run": "npm run typeorm -- migration:run",
        "migration:revert": "npm run typeorm -- migration:revert",
        "migration:show": "npm run typeorm -- migration:show",
        "migration:dev-run": "npm run build && npm run typeorm -- migration:run",
        "seed:run": "ts-node -r tsconfig-paths/register ./src/database/seeders/seed.helper.ts",
        "seed:reset-users": "ts-node -r tsconfig-paths/register ./src/database/seeders/reset-users.ts",
        "seed:run:prod": "node dist/database/seeders/seed.helper.js",
        "seed:reset-users:prod": "node dist/database/seeders/reset-users.js",
        "docker:dev": "docker-compose --profile dev up",
        "docker:dev:build": "docker-compose --profile dev up --build",
        "docker:dev:down": "docker-compose down",
        "docker:prod": "docker-compose --profile prod up -d",
        "docker:prod:build": "docker-compose --profile prod up --build -d",
        "docker:prod:down": "docker-compose --profile prod down",
        "docker:logs": "docker-compose logs -f",
        "docker:clean": "docker-compose down -v"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.21",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.21",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/microservices": "^11.1.21",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.21",
        "@nestjs/serve-static": "^5.0.5",
        "@nestjs/swagger": "^11.4.3",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/typeorm": "^11.0.1",
        "@types/jsdom": "^28.0.3",
        "@types/passport-jwt": "^4.0.1",
        "axios": "^1.16.1",
        "basic-auth": "^2.0.1",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.4",
        "cloudinary": "^1.41.3",
        "cookie-parser": "^1.4.7",
        "dompurify": "^3.4.10",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-basic-auth": "^1.2.1",
        "firebase-admin": "^13.10.0",
        "google-auth-library": "^10.6.2",
        "helmet": "^8.2.0",
        "i18next": "^25.10.10",
        "ioredis": "^5.10.1",
        "jose": "^6.2.3",
        "jsdom": "^29.1.1",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.1.1",
        "multer-storage-cloudinary": "^4.0.0",
        "nest-winston": "^1.10.2",
        "nestjs-i18n": "^10.8.4",
        "nodemailer": "^7.0.13",
        "openai": "^6.38.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.20.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "strip-bom": "^5.0.0",
        "typeorm": "^0.3.29",
        "typeorm-naming-strategies": "^4.1.0",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.3",
        "@commitlint/config-conventional": "^20.5.3",
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.4",
        "@nestjs/cli": "^11.0.21",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.1.21",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/dotenv": "^8.2.3",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.8.0",
        "@types/nodemailer": "^7.0.11",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.59.3",
        "@typescript-eslint/parser": "^8.59.3",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "esw": "^0.15.0",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "lint-staged": "^16.4.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.3",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.9",
        "ts-loader": "^9.5.7",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.59.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^src/(.*)$": "<rootDir>/$1"
        },
        "modulePaths": [
            "<rootDir>"
        ]
    }
}
