# ============================================================
# Server Configuration
# ============================================================
# MODE: DEV (development) | PROD (production)
#   - DEV:  cookies secure=false, sameSite=lax  (for localhost)
#   - PROD: cookies secure=true,  sameSite=none (requires HTTPS)
PORT=3000
MODE=PROD

# Comma-separated list of allowed frontend origins (CORS)
# Production example:
ALLOW_ORIGINS=https://cofixer.com,https://www.cofixer.com
# Development example:
# ALLOW_ORIGINS=http://localhost:5173

# Frontend base URL (used for redirects, CORS, etc.)
FRONTEND_URL=https://cofixer.com

# ============================================================
# Database Configuration (PostgreSQL)
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DATABASE=cofixer

# ============================================================
# JWT & Auth Configuration
# ============================================================
# Generate a strong secret: openssl rand -base64 48
AUTH_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_SECRET

AUTH_TOKEN_COOKIE_NAME=CoFixerToken
AUTH_TOKEN_EXPIRE_TIME=24h
AUTH_TOKEN_EXPIRED_TIME_REMEMBER_ME=30d

AUTH_REFRESH_TOKEN_COOKIE_NAME=CoFixerRefreshToken
AUTH_REFRESH_TOKEN_EXPIRE_TIME=7d

# ============================================================
# Mail Configuration (SMTP)
# ============================================================
MAIL_PORT=587
MAIL_HOST=smtp.gmail.com
MAIL_FROM=noreply@cofixer.com
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# ============================================================
# Redis Configuration
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_CACHE_TTL=3600
REDIS_PREFIX=cofixer

# ============================================================
# Cloudinary Configuration
# ============================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=cofixer

# ============================================================
# Admin Seed Configuration
# ============================================================
ADMIN_SEED_EMAIL=admin@cofixer.com
ADMIN_SEED_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
